{
  "name": "token-usage",
  "displayName": "Token Usage Profiler",
  "version": "0.8.0",
  "description": "A token profiler, not a cost meter: attributes Claude Code and Cowork usage to the slash command, skill or subagent that consumed it.",
  "author": {
    "name": "Craig Fletcher",
    "email": "craig@wickedsick.com"
  },
  "homepage": "https://github.com/Wicked-Sick-Ltd/token-usage#readme",
  "repository": "https://github.com/Wicked-Sick-Ltd/token-usage",
  "license": "MIT",
  "keywords": [
    "tokens",
    "usage",
    "cost",
    "profiler",
    "observability",
    "analytics",
    "cowork",
    "mcp"
  ],
  "documentationUrl": "https://github.com/Wicked-Sick-Ltd/token-usage#readme",
  "supportUrl": "https://github.com/Wicked-Sick-Ltd/token-usage/issues",
  "privacyPolicyUrl": "https://github.com/Wicked-Sick-Ltd/token-usage#privacy-and-data-handling",
  "mcpServers": {
    "token-usage": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_server.py"
      ],
      "env": {
        "TOKEN_USAGE_RUNTIME": "claude",
        "TOKEN_USAGE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
