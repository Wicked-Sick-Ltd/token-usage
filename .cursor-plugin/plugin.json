{
  "name": "token-usage",
  "displayName": "Token Usage Profiler",
  "version": "0.9.0",
  "description": "Attribute Cursor, Claude Code, Cowork, Codex, Google Antigravity, Gemini CLI, and Copilot CLI token usage to the work that consumed it — per-activity breakdowns, subagent rollups, cross-session history, live session ledger, cache-aware API-price estimates, and a bundled MCP server with optional Cursor hook attribution",
  "author": {
    "name": "Craig Fletcher",
    "email": "hello@wickedsick.com"
  },
  "repository": "https://github.com/Wicked-Sick-Ltd/token-usage",
  "homepage": "https://github.com/Wicked-Sick-Ltd/token-usage#readme",
  "documentationUrl": "https://github.com/Wicked-Sick-Ltd/token-usage#readme",
  "supportUrl": "https://github.com/Wicked-Sick-Ltd/token-usage/issues",
  "privacyPolicyUrl": "https://github.com/Wicked-Sick-Ltd/token-usage#privacy-and-data-handling",
  "license": "MIT",
  "category": "Developer Tools",
  "logo": "assets/logo.svg",
  "keywords": [
    "tokens",
    "usage",
    "cost",
    "profiler",
    "observability",
    "analytics",
    "cursor",
    "claude-code",
    "mcp"
  ],
  "skills": "skills/report",
  "hooks": "hooks/hooks-cursor.json",
  "mcpServers": {
    "token-usage": {
      "command": "python3",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/scripts/mcp_server.py"
      ],
      "env": {
        "TOKEN_USAGE_RUNTIME": "cursor",
        "PYTHONUTF8": "1"
      }
    }
  }
}
