{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/token_usage.py\" cursor-hook",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/token_usage.py\" cursor-hook",
        "timeout": 15
      }
    ],
    "subagentStart": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/token_usage.py\" cursor-hook",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/token_usage.py\" cursor-hook",
        "timeout": 15
      }
    ]
  }
}
