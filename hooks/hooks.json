{
  "description": "Keeps a per-session token-usage ledger up to date after every turn and every finished subagent (powers instant /token-usage:report and the optional statusline)",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/token_usage.py\" hook",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/activity_bridge.py\" hook --runtime claude --stdout claude",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/token_usage.py\" hook",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/activity_bridge.py\" hook --runtime claude --stdout claude",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
